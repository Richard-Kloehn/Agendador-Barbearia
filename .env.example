# Configurações do Flask
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao-use-algo-complexo
ADMIN_PASSWORD=senha-forte-do-admin-123

# URL base do seu aplicativo (importante para links de confirmação)
BASE_URL=http://localhost:5000

# Banco de dados
# Para desenvolvimento local:
DATABASE_URL=sqlite:///barbearia.db
# Para produção (ex: PostgreSQL):
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# Configurações de Agendamento
PRAZO_MINIMO_CANCELAMENTO_HORAS=2
PRAZO_MINIMO_REAGENDAMENTO_HORAS=2

# Porta do servidor
PORT=5000
